# -----------------------------------
# APP
# -----------------------------------
APP_NAME=Job Auto Apply
APP_ENV=development

# -----------------------------------
# DATABASE
# -----------------------------------
POSTGRES_DB=job_auto_apply
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
# Host port exposed by docker-compose.yml. Container port remains 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:your_password@localhost:5433/job_auto_apply

# -----------------------------------
# REDIS
# -----------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------
# BACKEND
# -----------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------
# JWT
# -----------------------------------
JWT_SECRET=your_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------
# FRONTEND
# -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------
# SCRAPER
# -----------------------------------
# Optional HTTP(S) proxy. Leave blank for direct local scraping.
SCRAPER_PROXY_URL=

# -----------------------------------
# AI
# -----------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
