# -----------------------------------
# APP
# -----------------------------------
APP_NAME=Job Auto Apply
APP_ENV=development

# -----------------------------------
# REDIS
# -----------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------
# DATABASE
# -----------------------------------
# Supabase Session Pooler is recommended for the Raspberry Pi runtime when
# the network is IPv4-only. Keep the password out of Git and CI logs.
# This is the server-side PostgreSQL connection used by FastAPI; it is not a
# Supabase anon/publishable API key.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres

# -----------------------------------
# BACKEND
# -----------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------
# SUPABASE AUTH
# -----------------------------------
SUPABASE_URL=
# Prefer the new publishable key from Settings > API Keys.
SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback while migrating away from anon keys.
SUPABASE_ANON_KEY=
# Server-only key for Supabase Admin API operations. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------
# RAZORPAY
# -----------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------
# FRONTEND / CORS
# -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# -----------------------------------
# SCRAPER
# -----------------------------------
SCRAPER_PROXY_URL=

# -----------------------------------
# AI
# -----------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
