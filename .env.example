# -----------------------------------
# APP
# -----------------------------------
APP_NAME=Job Auto Apply
APP_ENV=development

# -----------------------------------
# REDIS
# -----------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------
# DATABASE
# -----------------------------------
# Supabase Session Pooler is recommended for the Raspberry Pi runtime when
# the network is IPv4-only. Keep the password out of Git and CI logs.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres

# -----------------------------------
# BACKEND
# -----------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------
# JWT
# -----------------------------------
JWT_SECRET=your_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------
# FRONTEND
# -----------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------
# SCRAPER
# -----------------------------------
# Optional HTTP(S) proxy. Leave blank for direct local scraping.
SCRAPER_PROXY_URL=

# -----------------------------------
# AI
# -----------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
