[Unit]
Description=Job Auto Apply saved search alert scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iamgajanan
WorkingDirectory=/home/iamgajanan/Projects/job-auto-apply/backend
EnvironmentFile=/home/iamgajanan/Projects/job-auto-apply/.env
ExecStart=/home/iamgajanan/Projects/job-auto-apply/backend/.venv/bin/python -m app.features.saved_searches.alert_scheduler
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
